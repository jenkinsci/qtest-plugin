<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2189.v695a_c41f5249</version>
    <relativePath />
  </parent>

  <groupId>com.qasymphony.ci.jenkins</groupId>
  <artifactId>qtest</artifactId>
  <version>2025.2-SNAPSHOT</version>
  <packaging>hpi</packaging>
  <name>Jenkins qTest Plugin</name>
  <description>This plugin collects and reports unit test results to qTest.
    It supports any testing frameworks which are capable of generating JUnit XML format test reports.
  </description>
  <url>https://github.com/jenkinsci/qtest-plugin</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>http://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <organization>
    <name>QASymphony</name>
    <url>https://www.qasymphony.com/</url>
  </organization>

  <properties>
    <findbugs.skip>true</findbugs.skip>
    <httpclient.version>4.5.14</httpclient.version>
    <jenkins.version>2.555.3</jenkins.version>
    <commons-codec.version>1.16.0</commons-codec.version>
    <apache.sshd.version>2.17.1</apache.sshd.version>
    <spring.version>6.2.19</spring.version>
    <spring.security.version>6.5.11</spring.security.version>
    <maven.compiler.release>21</maven.compiler.release>
    <cloudsmith.maven.deploy.url>https://maven.cloudsmith.io/tricentis/qtest/</cloudsmith.maven.deploy.url>
    <!-- Use `mvn deploy -Dmaven.deploy.skip=false` when intentionally publishing to Cloudsmith. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
  <scm>
    <connection>scm:git:https://github.com/jenkinsci/${project.artifactId}-plugin.git</connection>
    <developerConnection>scm:git:git@github.com:jenkinsci/${project.artifactId}-plugin.git</developerConnection>
    <url>https://github.com/jenkinsci/${project.artifactId}-plugin</url>
    <tag>qtest-1.4.8</tag>
  </scm>

  <developers>
    <developer>
      <id>qasymphony</id>
      <email>info@qasymphony.com</email>
      <name>QASymphony</name>
      <timezone>7</timezone>
    </developer>
  </developers>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <distributionManagement>
    <repository>
      <id>cloudsmith</id>
      <name>Tricentis qTest (Cloudsmith)</name>
      <url>${cloudsmith.maven.deploy.url}</url>
    </repository>
    <snapshotRepository>
      <id>cloudsmith</id>
      <name>Tricentis qTest (Cloudsmith)</name>
      <url>${cloudsmith.maven.deploy.url}</url>
    </snapshotRepository>
  </distributionManagement>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-2.555.x</artifactId>
        <version>6585.va_085f4d47c41</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Force commons-lang3 to 3.20.0 (commons-compress 1.26.0 pins 3.14.0 but BOM-managed plugins need 3.20.0) -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>3.20.0</version>
      </dependency>
      <!-- Force spring-security-web to patched version (fixes SNYK-JAVA-ORGSPRINGFRAMEWORKSECURITY-17305998 User Impersonation) -->
      <dependency>
        <groupId>org.springframework.security</groupId>
        <artifactId>spring-security-web</artifactId>
        <version>${spring.security.version}</version>
      </dependency>
      <!-- Force mina-core to 2.2.8 (fixes CRITICAL CVE in transitive dep from mina-sshd-api-core Jenkins plugin) -->
      <dependency>
        <groupId>org.apache.mina</groupId>
        <artifactId>mina-core</artifactId>
        <version>2.2.8</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Jenkins plugin deps — versions managed by bom-2.555.x -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>junit</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>matrix-project</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
